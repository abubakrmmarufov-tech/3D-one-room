    "check:motion": "node scripts/check-motion.mjs",
    "check:package": "node scripts/check-package.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "node scripts/verify.mjs",
    "verify:motion": "node scripts/verify-motion.mjs",

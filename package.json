{
  "name": "dom-3d-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "artifact": "vite build && node scripts/make-artifact.mjs",
    "check": "node scripts/check-navigation.mjs && node scripts/check-furniture.mjs && node scripts/check-motion.mjs && node scripts/check-apartment-picking.mjs",
    "check:ui": "node scripts/check-plan-labels.mjs",
    "check:lighting": "node scripts/check-lighting-offline.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:inventory": "node --test scripts/check-inventory.mjs",
    "check:showcase": "node scripts/check-single-building.mjs",
    "catalog": "node scripts/build-catalog.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "0.25.0",
    "vite": "^5.4.10"
  }
}
